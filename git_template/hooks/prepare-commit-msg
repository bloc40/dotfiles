#!/bin/zsh
# Prefix the commit message with the branch name, e.g. "[feature-x] ...",
# unless the branch is in BRANCHES_TO_SKIP or the prefix is already there.

if [ -z "$BRANCHES_TO_SKIP" ]; then
  BRANCHES_TO_SKIP=(master main)
fi

BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null)
BRANCH_NAME="${BRANCH_NAME##*/}"
[ -n "$BRANCH_NAME" ] || exit 0

BRANCH_EXCLUDED=$(printf "%s\n" "${BRANCHES_TO_SKIP[@]}" | grep -c "^$BRANCH_NAME$")
BRANCH_IN_COMMIT=$(grep -c "\[$BRANCH_NAME\]" "$1")

if [ "$BRANCH_EXCLUDED" -eq 0 ] && [ "$BRANCH_IN_COMMIT" -eq 0 ]; then
  { printf '[%s] ' "$BRANCH_NAME"; cat "$1"; } > "$1.tmp" && mv "$1.tmp" "$1"
fi
