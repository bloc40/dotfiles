#!/bin/zsh
# Symlink this repo's dotfiles into $HOME.
#
#   ./install            link everything, back up files that are in the way
#   ./install -n         dry run: show what would happen
#   ./install --skip-nvim  don't bootstrap vim-plug / plugins
#
# Every top-level entry becomes ~/.<name>, except the ones in EXCLUDED.
# config/ is special: if ~/.config is already a real directory (other apps
# create it), its children are linked individually so nothing else in
# there is disturbed. Otherwise ~/.config points at config/ as a whole.

setopt err_exit no_unset pipe_fail

DOTFILES=${0:A:h}
EXCLUDED=( .git .DS_Store README.md install remove_symlinks shell iex.exs )

DRY_RUN=false
SKIP_NVIM=false
for arg in "$@"; do
  case $arg in
    -n|--dry-run)   DRY_RUN=true ;;
    --skip-nvim)    SKIP_NVIM=true ;;
    -h|--help)      sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 1 ;;
  esac
done

RED=$'\033[31m' GREEN=$'\033[32m' YELLOW=$'\033[33m' DIM=$'\033[2m' RESET=$'\033[0m'

say()  { printf '%s%-12s%s %s\n' "$1" "$2" "$RESET" "$3"; }
act()  { $DRY_RUN && set -- "$1" "would $2" "$3"; say "$@"; }   # for things run() would do
run()  { $DRY_RUN || "$@"; }
tilde() { [[ $1 == $HOME/* ]] && print -r -- "~/${1#$HOME/}" || print -r -- "$1"; }

# Back up a real file/dir that is in the way. Never overwrites an older backup.
backup() {
  local file=$1 dest=$1.bak
  [[ -e $dest ]] && dest=$1.bak.$(date +%Y%m%d%H%M%S)
  act "$YELLOW" backup "$(tilde "$file") -> $(tilde "$dest")"
  run mv "$file" "$dest"
}

# link <source in repo> <destination in $HOME>
link() {
  local src=$1 dst=$2 shown=$(tilde "$2")
  if [[ -L $dst ]]; then
    if [[ ${dst:A} == ${src:A} ]]; then
      say "$DIM" ok "$shown"
      return
    fi
    say "$RED" skip "$shown is a symlink to $(readlink "$dst")"
    return
  fi
  [[ -e $dst ]] && backup "$dst"
  act "$GREEN" link "$shown -> $(tilde "$src")"
  run ln -s "$src" "$dst"
}

# --- dotfiles -------------------------------------------------------------
for entry in "$DOTFILES"/*(DN); do
  name=${entry:t}
  (( ${EXCLUDED[(Ie)$name]} )) && continue

  if [[ $name == config && -d $HOME/.config && ! -L $HOME/.config ]]; then
    for child in "$entry"/*(DN); do
      (( ${EXCLUDED[(Ie)${child:t}]} )) && continue
      link "$child" "$HOME/.config/${child:t}"
    done
  else
    link "$entry" "$HOME/.$name"
  fi
done

# --- neovim ---------------------------------------------------------------
$SKIP_NVIM && exit 0
if ! command -v nvim >/dev/null 2>&1; then
  say "$YELLOW" nvim "not installed; skipping plugin setup"
  exit 0
fi

PLUG=${XDG_DATA_HOME:-$HOME/.local/share}/nvim/site/autoload/plug.vim
if [[ -f $PLUG ]]; then
  say "$DIM" ok "vim-plug"
else
  act "$GREEN" fetch "vim-plug -> $(tilde "$PLUG")"
  run curl -fsSLo "$PLUG" --create-dirs \
    https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
fi
act "$GREEN" nvim "PlugInstall"
run nvim --headless +'PlugInstall --sync' +qa
