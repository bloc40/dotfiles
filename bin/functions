# =====================================================================
# Scan the local network for live hosts
# =====================================================================

# lanscan() {
#   sudo nmap -sn 192.168.1.0/24
# }

lanscan() {
  {
    echo "IP|HOSTNAME|MAC|VENDOR"
    sudo nmap -sn "${1:-192.168.1.0/24}" | awk '
      function flush() {
        if (ip != "") printf "%s|%s|%s|%s\n", ip, host, mac, vendor
        ip = host = mac = vendor = ""
      }
      /^Nmap scan report for/ {
        flush()
        if (match($0, /\(([0-9.]+)\)$/)) {
          ip = substr($0, RSTART + 1, RLENGTH - 2); host = $5
        } else {
          ip = $NF; host = "-"
        }
        mac = "-"; vendor = "-"
        next
      }
      /^MAC Address:/ {
        mac = $3; vendor = "-"
        if (match($0, /\(.*\)$/)) vendor = substr($0, RSTART + 1, RLENGTH - 2)
        next
      }
      /^Nmap done/ { flush(); next }
      END { flush() }
    '
  } | column -t -s '|'
}
